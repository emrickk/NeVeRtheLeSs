---
import '../styles/pages/not-found.css';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import LangText from '../components/LangText.astro';
import LangTitle from '../components/LangTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
import { buildTranslationMap, resolveLangText } from '../utils/translations';

const tmap = await buildTranslationMap();

const recentPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// Every CDN photo in the recent posts' bodies, each pointing back at its
// post. The page shows one at random per visit (script below); the first,
// the newest post's opening photo, is the no-JS fallback.
interface PoolPhoto {
  src: string;
  alt: string;
  href: string;
  titleZh: string;
  titleEn: string;
}
const photoPool: PoolPhoto[] = [];
const seenPhotos = new Set<string>();
for (const post of recentPosts) {
  const text = resolveLangText(post.data, tmap);
  const postRef = {
    href: withBase(`/posts/${post.id}/`),
    titleZh: text.titleZh ?? post.data.title,
    titleEn: text.titleEn ?? post.data.title,
  };
  const addPhoto = (src: string | undefined, alt: string) => {
    if (!src || seenPhotos.has(src)) return;
    seenPhotos.add(src);
    photoPool.push({ src, alt, ...postRef });
  };
  const body = post.body ?? '';
  for (const m of body.matchAll(/!\[([^\]]*)\]\((https:\/\/cdn\.theneverless\.com\/[^)\s]+)\)/g)) {
    addPhoto(m[2], m[1]);
  }
  for (const m of body.matchAll(/<img\s[^>]*>/g)) {
    addPhoto(
      m[0].match(/src="(https:\/\/cdn\.theneverless\.com\/[^"]+)"/)?.[1],
      m[0].match(/alt="([^"]*)"/)?.[1] ?? ''
    );
  }
}
const firstPhoto = photoPool[0];

const copy = {
  title: { zh: '找不到这个页面', en: 'Page not found' },
  search: { zh: '搜索', en: 'Search' },
  home: { zh: '首页', en: 'Home' },
  recent: { zh: '最近的文章', en: 'Recent posts' },
};
---

<BaseLayout
  title="Page not found"
  description="The page you requested does not exist."
  robots="noindex, follow"
  canonicalUrl={withBase('/404.html')}
  pageUrl={withBase('/404.html')}
>
  <main class="not-found-main" id="main-content">
    <div class="not-found-inner">
      <p class="not-found-code" aria-hidden="true">404</p>
      <h1 class="not-found-title"><LangText text={copy.title} /></h1>
      <div class="not-found-actions">
        <a href={withBase('/search')} class="btn btn-primary" data-search-palette-trigger="true">
          <LangText text={copy.search} />
        </a>
        <a href={withBase('/')} class="btn btn-secondary"><LangText text={copy.home} /></a>
      </div>

      {
        firstPhoto && (
          <figure class="not-found-photo">
            <a class="not-found-photo-link" href={firstPhoto.href} data-not-found-photo>
              <img src={firstPhoto.src} alt={firstPhoto.alt} decoding="async" />
            </a>
            <figcaption class="not-found-photo-caption">
              <span class="lang lang-zh" data-orig
                >照片来自<a href={firstPhoto.href} data-not-found-caption-zh
                  >《{firstPhoto.titleZh}》</a
                ></span
              ><span class="lang lang-en"
                >Photo from <a href={firstPhoto.href} data-not-found-caption-en
                  >{firstPhoto.titleEn}</a
                ></span
              >
            </figcaption>
          </figure>
        )
      }
      <script is:inline define:vars={{ photoPool }}>
        (() => {
          const link = document.querySelector('[data-not-found-photo]');
          const img = link ? link.querySelector('img') : null;
          const capZh = document.querySelector('[data-not-found-caption-zh]');
          const capEn = document.querySelector('[data-not-found-caption-en]');
          if (!link || !img || !capZh || !capEn || photoPool.length < 2) return;
          const pick = photoPool[Math.floor(Math.random() * photoPool.length)];
          link.href = pick.href;
          img.src = pick.src;
          img.alt = pick.alt;
          capZh.href = pick.href;
          capZh.textContent = '《' + pick.titleZh + '》';
          capEn.href = pick.href;
          capEn.textContent = pick.titleEn;
        })();
      </script>

      {
        recentPosts.length > 0 && (
          <nav class="not-found-recent" aria-labelledby="not-found-recent-heading">
            <h2 id="not-found-recent-heading" class="not-found-recent-heading eyebrow-accent">
              <LangText text={copy.recent} />
            </h2>
            <ul class="not-found-recent-list">
              {recentPosts.map((post) => {
                const text = resolveLangText(post.data, tmap);

                return (
                  <li>
                    <a href={withBase(`/posts/${post.id}/`)} class="not-found-recent-item">
                      <LangTitle
                        tag="span"
                        class="not-found-recent-title"
                        zh={text.titleZh}
                        en={text.titleEn}
                        orig={post.data.lang ?? 'zh'}
                        fallback={post.data.title}
                      />
                      <FormattedDate date={post.data.pubDate} class="not-found-recent-date" />
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        )
      }
    </div>
  </main>
</BaseLayout>
