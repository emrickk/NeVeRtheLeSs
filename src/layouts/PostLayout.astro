---
import 'toc-rail/style.css';
import '../styles/layouts/post.css';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArchivedComments from '../components/ArchivedComments.astro';
import Comments from '../components/Comments.astro';
import FeaturedPostGrid from '../components/FeaturedPostGrid.astro';
import FormattedDate from '../components/FormattedDate.astro';
import LangText from '../components/LangText.astro';
import LangTitle from '../components/LangTitle.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import ProtectedGate from '../components/ProtectedGate.astro';
import ScrollFocus from '../components/ScrollFocus.astro';
import BaseLayout from './BaseLayout.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
import { getUiText, langPair } from '../ui';
import { withBase } from '../utils/paths';
import { serializeScriptJson } from '../utils/serialize-script-json';
import {
  buildTranslationMap,
  htmlLangFor,
  ogLocaleFor,
  resolveLangText,
  type Lang,
  type PageAlternates,
} from '../utils/translations';

type Props = CollectionEntry<'posts'>['data'] & {
  slug?: string;
  readingTime?: number;
  relatedPosts?: CollectionEntry<'posts'>[];
  olderPost?: CollectionEntry<'posts'>;
  newerPost?: CollectionEntry<'posts'>;
};

const {
  slug,
  title,
  lang: origLang = 'zh',
  translationKey,
  description,
  pubDate,
  updatedDate,
  heroImage,
  showHero,
  readingTime,
  focusEffect,
  draft = false,
  protected: isProtected = false,
  relatedPosts = [],
  olderPost,
  newerPost,
} = Astro.props;

const tr = getUiText();
const postsBase = withBase('/posts');

// zh/en display text: own language from this post's frontmatter, the other
// language from the sibling translation file.
const tmap = await buildTranslationMap();
const text = resolveLangText({ title, description, lang: origLang, translationKey }, tmap);
const otherLang: Lang = origLang === 'zh' ? 'en' : 'zh';
// The page has the other language only when the sibling translation exists:
// its body renders beside the primary and the toggle can show it.
const hasSibling = Boolean(translationKey && tmap.has(`${translationKey}:${otherLang}`));
const pageLangs: Lang[] = hasSibling ? [origLang, otherLang] : [origLang];
const alternates: PageAlternates = {
  zh: { title: text.titleZh ?? title, description: text.descriptionZh ?? description },
  en: { title: text.titleEn ?? title, description: text.descriptionEn ?? description },
};
if (!hasSibling) delete alternates[otherLang];
const olderText = olderPost ? resolveLangText(olderPost.data, tmap) : undefined;
const newerText = newerPost ? resolveLangText(newerPost.data, tmap) : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pubDateISO = pubDate.toISOString();
const updatedDateISO = updatedDate?.toISOString();

const jsonLd = serializeScriptJson({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDateISO,
  ...(updatedDateISO && { dateModified: updatedDateISO }),
  url: canonicalURL.href,
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  inLanguage: htmlLangFor(origLang),
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  pubDate={pubDateISO}
  updatedDate={updatedDateISO}
  lang={origLang}
  langs={pageLangs}
  alternates={alternates}
  locale={ogLocaleFor(origLang)}
  robots={draft ? 'noindex' : undefined}
  bodyClass="post-page"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  {focusEffect && <ScrollFocus variant={focusEffect} />}

  <main id="main-content" class="post-main">
    {/* Draft pages exist only in dev and review builds (src/utils/drafts.ts)
        and carry a visible marker. */}
    <article data-draft-page={draft ? '' : undefined}>
      <a href={postsBase} class="back-link">
        <LangText text={tr.backLink} />
      </a>

      <header class="post-header">
        <div class="post-accent"></div>
        <div class="post-meta">
          {draft && <span class="draft-marker">Draft · 草稿</span>}
          <FormattedDate class="meta-date" date={pubDate} />
          {
            readingTime && (
              <>
                <span class="dot">·</span>
                <span class="meta-item">
                  <LangText text={tr.readingTime(readingTime)} />
                </span>
              </>
            )
          }
          {
            updatedDate && (
              <>
                <span class="dot">·</span>
                <span class="meta-updated">
                  <LangText text={tr.updated} /> <FormattedDate date={updatedDate} />
                </span>
              </>
            )
          }
        </div>
        <LangTitle
          tag="h1"
          class="post-title"
          zh={text.titleZh}
          en={text.titleEn}
          orig={origLang}
          fallback={title}
        />
        {
          description && (
            <p class="post-description">
              <LangTitle
                zh={text.descriptionZh}
                en={text.descriptionEn}
                orig={origLang}
                fallback={description}
              />
            </p>
          )
        }
      </header>

      {
        showHero && heroImage && (
          <figure class="post-hero">
            <Image
              src={heroImage}
              alt={title}
              class="post-hero-img"
              widths={[480, 784, 1200, 1568]}
              sizes="(max-width: 816px) calc(100vw - 32px), 784px"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )
      }

      <div class="post-divider"></div>

      <div class="prose" id="prose-content">
        {isProtected && <ProtectedGate />}
        <slot />
      </div>

      {
        (olderPost || newerPost) && (
          <nav class="post-nav" aria-label={langPair(tr.postNav.label)}>
            {olderPost && (
              <a href={`${postsBase}/${olderPost.id}/`} class="post-nav-card post-nav-older">
                <span class="post-nav-label">
                  <LangText text={tr.postNav.older} />
                </span>
                <LangTitle
                  class="post-nav-title"
                  zh={olderText?.titleZh}
                  en={olderText?.titleEn}
                  orig={olderPost.data.lang ?? 'zh'}
                  fallback={olderPost.data.title}
                />
                <FormattedDate class="post-nav-date" date={olderPost.data.pubDate} />
              </a>
            )}
            {newerPost && (
              <a href={`${postsBase}/${newerPost.id}/`} class="post-nav-card post-nav-newer">
                <span class="post-nav-label">
                  <LangText text={tr.postNav.newer} />
                </span>
                <LangTitle
                  class="post-nav-title"
                  zh={newerText?.titleZh}
                  en={newerText?.titleEn}
                  orig={newerPost.data.lang ?? 'zh'}
                  fallback={newerPost.data.title}
                />
                <FormattedDate class="post-nav-date" date={newerPost.data.pubDate} />
              </a>
            )}
          </nav>
        )
      }

      {
        relatedPosts.length > 0 && (
          <section class="related-section">
            <div class="related-header">
              <p class="related-label">
                <LangText text={tr.relatedPosts} />
              </p>
              <a href={postsBase} class="related-view-all">
                <LangText text={tr.allPosts} />
              </a>
            </div>
            <FeaturedPostGrid posts={relatedPosts} variant="related" />
          </section>
        )
      }
    </article>
    {slug && <ArchivedComments slug={slug} />}
    <Comments />
  </main>
  <ImageLightbox />

  <script>
    import { mountReadingRailLoader } from '../scripts/reading-rail-loader';

    mountReadingRailLoader();
  </script>
</BaseLayout>
