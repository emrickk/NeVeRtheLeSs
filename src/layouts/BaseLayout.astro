---
import type { ImageMetadata } from 'astro';
import config from '../../astro-theme-config';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { htmlLangFor, type Lang, type PageAlternates } from '../utils/translations';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  ogImageUrl?: string;
  type?: 'website' | 'article';
  pubDate?: string;
  updatedDate?: string;
  robots?: string;
  canonicalUrl?: string;
  pageUrl?: string;
  /** Language of the page's server-rendered (no-JS) main content. Defaults to zh. */
  lang?: Lang;
  /**
   * Languages the page's main content exists in. The toggle sets
   * document.documentElement.lang to the selected language only when the page
   * has it; otherwise the page keeps `lang`. Defaults to both.
   */
  langs?: Lang[];
  /** Per-language document title and description, swapped by the toggle. */
  alternates?: PageAlternates;
  locale?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  image,
  ogImageUrl,
  type,
  pubDate,
  updatedDate,
  robots,
  canonicalUrl,
  pageUrl,
  lang = 'zh',
  langs = ['zh', 'en'],
  alternates,
  locale,
  bodyClass,
} = Astro.props;
const htmlLang = htmlLangFor(lang);
---

<!doctype html>
<html
  lang={htmlLang}
  data-page-lang={lang}
  data-langs={langs.join(' ')}
  data-smooth-scroll={config.behavior.smoothScroll ? 'true' : 'false'}
>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogImageUrl={ogImageUrl}
      type={type}
      pubDate={pubDate}
      updatedDate={updatedDate}
      robots={robots}
      canonicalUrl={canonicalUrl}
      pageUrl={pageUrl}
      locale={locale}
      alternates={alternates}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <SearchPalette />
    <slot />
    <Footer />
    <script>
      import { onReady } from '../scripts/mount';
      import { mountImageLoadingStates } from '../scripts/image-loading';
      import { mountSkipLinkFocus } from '../scripts/skip-link';

      onReady(mountSkipLinkFocus);
      onReady(mountImageLoadingStates);
    </script>
  </body>
</html>
