---
import config from '../../astro-theme-config';
import HeaderLink from './HeaderLink.astro';
import LangText from './LangText.astro';
import LangToggle from './LangToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getUiText, langPair } from '../ui';
import { withBase } from '../utils/paths';

const headerText = getUiText().header;
const navAriaLabel = langPair(headerText.navLabel);
const headerTitle = config.site.logoLabel || config.site.title;
const navItems = config.nav;
---

<a href="#main-content" class="skip-link" tabindex="0">
  <LangText text={headerText.skipLink} />
</a>
<header class="site-header glass">
  <nav class="nav-inner" aria-label={navAriaLabel}>
    <a href={withBase('/')} class="nav-logo">{headerTitle}</a>
    <div class="nav-right">
      <div class="nav-links">
        {
          navItems.map((item) => (
            <HeaderLink href={item.href}>
              {item.labelZh ? <LangText text={{ zh: item.labelZh, en: item.label }} /> : item.label}
            </HeaderLink>
          ))
        }
      </div>
      <LangToggle />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    function mountAutoHideHeader() {
      const header = document.querySelector('.site-header');
      if (!(header instanceof HTMLElement) || header.dataset.scrollReady === 'true') return;
      header.dataset.scrollReady = 'true';

      let lastY = window.scrollY;
      let ticking = false;

      const sync = () => {
        const currentY = window.scrollY;
        const delta = currentY - lastY;
        const activeElement = document.activeElement;
        const hasKeyboardFocus =
          activeElement instanceof HTMLElement &&
            header.contains(activeElement) &&
            activeElement.matches(':focus-visible');

        header.classList.toggle('is-scrolled', currentY > 8);

        if (currentY < 24 || hasKeyboardFocus) {
          header.classList.remove('is-hidden');
        } else if (delta > 8 && currentY > 96) {
          header.classList.add('is-hidden');
        } else if (delta < -8) {
          header.classList.remove('is-hidden');
        }

        lastY = currentY;
        ticking = false;
      };

      sync();

      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(sync);
            ticking = true;
          }
        },
        { passive: true }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mountAutoHideHeader, { once: true });
    } else {
      mountAutoHideHeader();
    }
  })();
</script>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--nav-height);
  border-bottom: none;
  background-color: var(--bg-primary);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  transform: translateY(0);
  transition:
    transform var(--duration-normal) var(--ease-out),
    background-color var(--duration-fast) var(--ease-out);
  will-change: transform;
}

.site-header.glass {
  background-color: var(--bg-primary);
}

:global([data-theme='dark']) .site-header.glass,
:global(:root:not([data-theme='light'])) .site-header.glass {
  background-color: var(--bg-primary);
}

.site-header.glass.is-scrolled {
  background-color: color-mix(in srgb, var(--bg-primary) 88%, transparent);
}

:global([data-theme='dark']) .site-header.glass.is-scrolled {
  background-color: color-mix(in srgb, var(--bg-primary) 82%, transparent);
}

.site-header.is-hidden {
  transform: translateY(calc(-1 * var(--nav-height)));
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--max-width-wide);
  margin: 0 auto;
  padding: 0 var(--space-6);
  height: 100%;
}

.nav-logo {
  position: relative;
  font-size: var(--text-headline);
  font-weight: var(--weight-semibold);
  color: var(--label-primary);
  text-decoration: none;
  letter-spacing: var(--tracking-tight);
  transition:
    color var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}

/* Invisible 44px-tall hit area; the visible layout stays the same. */
.nav-logo::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 0;
  left: 0;
  height: 44px;
  transform: translateY(-50%);
}

.nav-logo:hover {
  opacity: 0.7;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: var(--space-5);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

@media (min-width: 55rem) {
  .nav-right {
    margin-right: calc(var(--max-width-wide) - var(--max-width-content) - var(--space-12));
  }
}

@media (max-width: 600px) {
  .nav-inner {
    padding: 0 var(--space-4);
  }

  .nav-right {
    gap: var(--space-3);
    margin-right: 0;
  }

  .nav-links {
    gap: var(--space-3);
  }
}

/* Narrow phones: tighten spacing so the logo and nav keep a clear gap. */
@media (max-width: 400px) {
  .nav-right,
  .nav-links {
    gap: 10px;
  }

  .nav-right :global(.theme-toggle) {
    width: 24px;
  }

  .nav-right :global(.lang-opt) {
    padding-right: 0.05rem;
    padding-left: 0.05rem;
  }
}

@media (max-width: 374px) {
  .nav-logo {
    font-size: 1rem;
  }

  .nav-right,
  .nav-links {
    gap: 8px;
  }
}

/* Too narrow for one row: logo and toggles on top, nav links below. */
@media (max-width: 354px) {
  :global(:root) {
    --nav-height: 88px;
  }

  .nav-inner {
    display: grid;
    grid-template-rows: 46px 42px;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: 8px;
  }

  .nav-right {
    display: contents;
  }

  .nav-logo {
    grid-row: 1;
    grid-column: 1;
    justify-self: start;
    font-size: var(--text-headline);
  }

  .nav-links {
    grid-row: 2;
    grid-column: 1 / -1;
    gap: var(--space-4);
  }

  .nav-right :global(.lang-toggle) {
    grid-row: 1;
    grid-column: 2;
  }

  .nav-right :global(.theme-toggle) {
    grid-row: 1;
    grid-column: 3;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-header {
    transition: none;
  }
}
</style>
