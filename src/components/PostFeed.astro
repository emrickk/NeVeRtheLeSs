---
import type { CollectionEntry } from 'astro:content';
import config from '../../astro-theme-config';
import { getUiText, langPair } from '../ui';
import { withBase } from '../utils/paths';
import FormattedDate from './FormattedDate.astro';
import LangText from './LangText.astro';
import LangTitle from './LangTitle.astro';
import { buildTranslationMap, resolveLangText } from '../utils/translations';

type PostEntry = CollectionEntry<'posts'>;

type Props = {
  posts: PostEntry[];
  basePath?: string;
  headingLevel?: 'h2' | 'h3';
  showFilters?: boolean;
  showMore?: boolean;
  initialVisible?: number;
};

const {
  posts,
  basePath = '/posts',
  headingLevel = 'h2',
  showFilters = true,
  showMore = true,
  initialVisible = 8,
} = Astro.props;

const labels = getUiText().postFeed;

const tmap = await buildTranslationMap();

const postSlug = (id: string) => id;
const categoryOrder = config.content.categoryOrder;
const sortByCategoryOrder = (a: string, b: string) => {
  const aIndex = categoryOrder.indexOf(a);
  const bIndex = categoryOrder.indexOf(b);
  if (aIndex !== -1 || bIndex !== -1) {
    return (
      (aIndex === -1 ? categoryOrder.length : aIndex) -
      (bIndex === -1 ? categoryOrder.length : bIndex)
    );
  }
  return a.localeCompare(b);
};
const categories = [
  ...new Set(
    posts
      .map((post) => post.data.category)
      .filter((category): category is string => Boolean(category))
  ),
].sort(sortByCategoryOrder);
const categoryLabels = config.content.categoryLabels;
const categoryLabel = (category: string) =>
  categoryLabels[category] ?? { zh: category, en: category };
const filters = categories.map((category) => ({
  key: `category:${category}`,
  label: categoryLabel(category),
  count: posts.filter((post) => post.data.category === category).length,
}));
---

<section
  class="post-feed"
  data-post-feed
  data-page-size={initialVisible}
  data-show-more={showMore ? 'true' : 'false'}
>
  {
    showFilters && filters.length > 0 && (
      <div class="feed-controls">
        <div class="feed-filter-rail" data-feed-filter-rail>
          <button
            type="button"
            class="feed-filter-scroll feed-filter-scroll-prev"
            data-feed-filter-scroll="prev"
            aria-label={langPair(labels.previousCategories)}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <div
            class="feed-filters"
            data-feed-filters
            role="group"
            aria-label={langPair(labels.filterLabel)}
          >
            <button
              type="button"
              class="feed-filter is-active"
              data-feed-filter="all"
              aria-pressed="true"
            >
              <span>
                <LangText text={labels.all} />
              </span>
              <span class="feed-filter-count">{posts.length}</span>
            </button>
            {filters.map((filter) => (
              <button
                type="button"
                class="feed-filter"
                data-feed-filter={filter.key}
                aria-pressed="false"
              >
                <span>
                  <LangText text={filter.label} />
                </span>
                <span class="feed-filter-count">{filter.count}</span>
              </button>
            ))}
          </div>
          <button
            type="button"
            class="feed-filter-scroll feed-filter-scroll-next"
            data-feed-filter-scroll="next"
            aria-label={langPair(labels.nextCategories)}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
    )
  }

  <ol class="feed-list">
    {
      posts.map((post, index) => {
        const text = resolveLangText(post.data, tmap);

        return (
          <li
            class="feed-item"
            data-feed-item
            data-category={post.data.category ?? ''}
            data-index={index}
          >
            <a href={withBase(`${basePath}/${postSlug(post.id)}/`)} class="feed-link">
              <FormattedDate class="feed-date" date={post.data.pubDate} />
              <div class="feed-body">
                <LangTitle
                  tag={headingLevel}
                  class="feed-title"
                  zh={text.titleZh}
                  en={text.titleEn}
                  orig={post.data.lang ?? 'zh'}
                  fallback={post.data.title}
                />
                {post.data.description && (
                  <p class="feed-desc">
                    <LangTitle
                      zh={text.descriptionZh}
                      en={text.descriptionEn}
                      orig={post.data.lang ?? 'zh'}
                      fallback={post.data.description}
                    />
                  </p>
                )}
                {post.data.category && (
                  <div class="feed-meta">
                    <span class="feed-category">
                      <LangText text={categoryLabel(post.data.category)} />
                    </span>
                  </div>
                )}
              </div>
              <span class="feed-arrow" aria-hidden="true">
                ↗
              </span>
              <span class="sr-only">
                <LangText text={labels.read} />
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <p class="feed-empty" data-feed-empty hidden>
    <LangText text={labels.empty} />
  </p>
  {
    showMore && posts.length > initialVisible && (
      <>
        <button type="button" class="feed-more" data-feed-more>
          <LangText text={labels.more} />
        </button>
        <div class="feed-sentinel" data-feed-sentinel aria-hidden="true" />
      </>
    )
  }
</section>

<script>
  import { onReady } from '../scripts/mount';
  import { mountPostFeeds } from '../scripts/post-feed';

  onReady(mountPostFeeds);
</script>

<style>
  .post-feed {
    --feed-date-column: 7.375rem;
    --feed-control-height: 2rem;
    --feed-more-height: 2.5rem;
    --feed-hover-shift: 0.125rem;
    --feed-date-size: var(--text-footnote);

    display: grid;
    gap: var(--space-6);
  }

  /* min-width: 0 keeps the scrolling filter rail from widening the feed. */
  .feed-controls {
    min-width: 0;
    border-bottom: 1px solid var(--separator);
  }

  .feed-filter-rail {
    position: relative;
    width: min(100%, 38rem);
    min-width: 0;
  }

  .feed-filters {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-5);
    align-items: flex-start;
    min-width: 0;
    padding-right: var(--space-8);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: var(--space-1) var(--space-8);
    scrollbar-width: none;
    user-select: none;
    mask-image: linear-gradient(90deg, #000 calc(100% - 1.75rem), transparent);
  }

  .feed-filters.is-dragging {
    cursor: grabbing;
  }

  .feed-filters::-webkit-scrollbar {
    display: none;
  }

  .feed-filter {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--feed-control-height);
    flex: 0 0 auto;
    border: 0;
    border-radius: 0;
    padding: 0 0 var(--space-3);
    background: transparent;
    color: var(--label-tertiary);
    font: inherit;
    font-size: var(--text-footnote);
    font-weight: 450;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .feed-filter::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    border-radius: var(--radius-full);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .feed-filter:hover,
  .feed-filter.is-active {
    color: var(--label-primary);
  }

  .feed-filter.is-active::after {
    transform: scaleX(1);
  }

  .feed-filter-count {
    color: var(--label-tertiary);
    font-size: var(--text-caption-2);
    font-variant-numeric: tabular-nums;
  }

  .feed-filter-scroll {
    display: none;
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: var(--space-3);
    place-items: center;
    width: 1.875rem;
    border: 0;
    padding: 0;
    background: color-mix(in srgb, var(--bg-primary) 86%, transparent);
    color: var(--label-secondary);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .feed-filter-scroll:hover {
    color: var(--label-primary);
  }

  .feed-filter-scroll:disabled {
    cursor: default;
    opacity: 0 !important;
    pointer-events: none;
  }

  .feed-filter-scroll svg {
    display: block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feed-filter-scroll-prev {
    left: 0;
  }

  .feed-filter-scroll-next {
    right: 0;
  }

  .feed-filter-rail.has-filter-overflow:not(.is-at-start) .feed-filters {
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 1.75rem,
      #000 calc(100% - 1.75rem),
      transparent
    );
  }

  .feed-filter-rail.has-filter-overflow.is-at-end .feed-filters {
    mask-image: linear-gradient(90deg, transparent, #000 1.75rem);
  }

  @media (hover: hover) and (pointer: fine) {
    .feed-filter-scroll {
      display: grid;
    }

    .feed-filters {
      cursor: grab;
    }

    .feed-filter-rail:hover .feed-filter-scroll:not(:disabled),
    .feed-filter-rail:focus-within .feed-filter-scroll:not(:disabled) {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .feed-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feed-item {
    border-bottom: 1px solid var(--fill-tertiary);
  }

  .feed-item[hidden] {
    display: none;
  }

  .feed-link {
    display: grid;
    grid-template-columns: var(--feed-date-column) minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-5) 0;
    color: inherit;
    text-decoration: none;
  }

  .feed-link:hover {
    opacity: 1;
  }

  .feed-link :global(.feed-date) {
    color: var(--label-tertiary);
    font-size: var(--feed-date-size);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .feed-body {
    min-width: 0;
    max-width: 100%;
  }

  /* Rendered by LangTitle, so the heading never gets this component's scope
 attribute; reach it via :global() under a scoped ancestor (same pattern as
 .feed-date above). */
  .feed-body :global(.feed-title) {
    margin: 0;
    color: var(--label-primary);
    font-size: var(--text-title-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    letter-spacing: -0.012em;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .feed-link:hover :global(.feed-title) {
    color: var(--color-blue);
  }

  .feed-desc {
    max-width: min(62ch, 100%);
    margin: var(--space-2) 0 0;
    color: var(--label-secondary);
    font-size: var(--text-callout);
    line-height: var(--leading-normal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .feed-category {
    color: var(--color-blue);
    font-size: var(--text-caption-2);
    font-weight: 550;
  }

  .feed-arrow {
    color: var(--label-quaternary);
    font-size: var(--text-callout);
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .feed-link:hover .feed-arrow {
    color: var(--color-blue);
    transform: translate(var(--feed-hover-shift), calc(var(--feed-hover-shift) * -1));
  }

  .feed-more {
    justify-self: center;
    height: var(--feed-more-height);
    padding: 0 var(--space-5);
    border: 1px solid color-mix(in srgb, var(--label-primary) 12%, transparent);
    border-radius: var(--radius-full);
    background: var(--bg-primary);
    color: var(--label-secondary);
    font: inherit;
    font-size: var(--text-footnote);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .feed-more:hover {
    color: var(--color-blue);
    border-color: color-mix(in srgb, var(--color-blue) 32%, transparent);
  }

  .feed-more[hidden],
  .feed-empty[hidden] {
    display: none;
  }

  .feed-empty {
    margin: 0;
    color: var(--label-tertiary);
    font-size: var(--text-callout);
  }

  .feed-sentinel {
    height: 1px;
  }

  @media (max-width: 42.5rem) {
    .feed-filter-rail {
      width: 100%;
    }

    .feed-filter-scroll {
      display: none;
    }

    .feed-link {
      grid-template-columns: 1fr auto;
      gap: var(--space-3);
      padding: var(--space-5) 0;
    }

    .feed-link :global(.feed-date) {
      grid-column: 1 / -1;
    }

    .feed-body :global(.feed-title) {
      font-size: var(--text-headline);
    }

    .feed-desc {
      font-size: var(--text-footnote);
    }
  }
</style>
