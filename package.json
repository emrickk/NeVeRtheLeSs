{
  "name": "theneverless",
  "description": "NeVeRtheLeSs, a bilingual personal blog since 2005. Built with Astro and the astro-tone theme.",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "NeVeRtheLeSs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrickk/NeVeRtheLeSs.git"
  },
  "bugs": {
    "url": "https://github.com/emrickk/NeVeRtheLeSs/issues"
  },
  "homepage": "https://theneverless.com",
  "keywords": [
    "astro",
    "blog",
    "personal-blog",
    "bilingual",
    "markdown",
    "pagefind"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --force-language zh-cn",
    "preview": "astro preview",
    "preview-posts": "node scripts/preview-posts.mjs",
    "astro": "astro",
    "check": "astro check",
    "check:links": "node scripts/check-built-links.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css,md,mdx}\"",
    "lint": "eslint \"src/**/*.{js,ts,astro}\" \"*.mjs\" \"scripts/**/*.mjs\" \"scripts/post-editor/ui/*.js\"",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "images": "node scripts/images/process.mjs",
    "images:migrate": "node scripts/images/migrate.mjs",
    "images:dimensions": "node scripts/images/dimensions.mjs",
    "library:car-variants": "node scripts/library/car-variants.mjs",
    "library:poster-variants": "node scripts/library/poster-variants.mjs",
    "test:images": "node --test \"scripts/images/*.test.mjs\"",
    "test:rehype": "node --test \"scripts/rehype/*.test.mjs\"",
    "test:editor": "node --test scripts/post-editor/api.test.mjs",
    "test:library": "node --test \"scripts/library/*.test.mjs\"",
    "test:drafts": "node --test scripts/drafts-build.test.mjs",
    "checkpoint": "node scripts/checkpoint.mjs",
    "release-check": "node scripts/release-check.mjs",
    "ship": "node scripts/ship.mjs",
    "check:content": "node scripts/content-check.mjs",
    "test:safety": "node --test scripts/checkpoint.test.mjs scripts/release-check.test.mjs scripts/preview-posts.test.mjs scripts/ship.test.mjs scripts/content-check.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-s3": "^3.1085.0",
    "astro": "^7.4.4",
    "astro-expressive-code": "^0.44.3",
    "hast-util-to-html": "^9.0.5",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.5",
    "toc-rail": "^0.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.5.2",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@typescript-eslint/scope-manager": "8.72.1",
    "@typescript-eslint/types": "8.72.1",
    "@typescript-eslint/visitor-keys": "8.72.1",
    "yaml-language-server": {
      "yaml": "2.8.4"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
