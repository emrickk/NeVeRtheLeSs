# Optional giscus comments.
# Fill these values from https://giscus.app, then choose one mode:
# PUBLIC_GISCUS_MODE=off
# PUBLIC_GISCUS_MODE=giscus
# PUBLIC_GISCUS_MODE=giscus-custom
PUBLIC_GISCUS_MODE=off
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_REACTIONS_ENABLED=0

# Cloudflare R2 image storage (values from the R2 dashboard; real secrets go in .env.local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anping-blog-images
R2_PUBLIC_BASE=https://cdn.theneverless.com
# Optional: SMB-mounted NAS folder for full-res originals (falls back to local originals/ if unset)
NAS_ARCHIVE_PATH=

# Password for posts with `protected: true` frontmatter (real value goes in
# .env.local; deploys read the POST_PASSWORD GitHub Actions secret, which must
# hold the same value). Runbook: docs/protected-posts.md
POST_PASSWORD=

# Library refresh (scripts/library/build-snapshot.mjs), local folders; set real paths in .env.local only.
# LIBRARY_EXPORT_DIR: the cleaned media-library export folder (same as --source).
# LIBRARY_RESOLVED_DIR: folder holding library-resolved-YYYYMMDD.json exports (same as --resolved-dir).
LIBRARY_EXPORT_DIR=
LIBRARY_RESOLVED_DIR=
